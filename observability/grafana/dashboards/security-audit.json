    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"vault\", container=\"vault\"} |= \"\\\"type\\\":\\\"request\\\"\" | json | auth_display_name=\"root\" [24h])) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Root token uses (24h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "denied"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"vault\", container=\"vault\"} |= \"\\\"type\\\":\\\"response\\\"\" != \"permission denied\" [$__auto]))",
          "legendFormat": "allowed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"vault\", container=\"vault\"} |= \"\\\"type\\\":\\\"response\\\"\" |= \"permission denied\" [$__auto]))",
          "legendFormat": "denied",
          "refId": "B"
        }
      ],
      "title": "Vault requests: allowed vs denied",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (user_username, objectRef_namespace) (count_over_time({job=\"kubernetes-audit\"} | json | objectRef_resource=\"secrets\" | verb=~\"get|list|watch\" | user_username!~\"system:.*\" [24h]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Secret reads by humans (24h)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"vault\", container=\"vault\"} |= \"\\\"type\\\":\\\"response\\\"\" |= \"permission denied\" | json | line_format `{{.request_path}} by {{.auth_display_name}} ({{.auth_metadata_service_account_namespace}}/{{.auth_metadata_service_account_name}}): {{.error}}`",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Denied Vault requests",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"kubernetes-audit\"} | json | user_username!~\"system:.*\" | objectRef_subresource=~\"exec|portforward|attach\" or objectRef_resource=~\"clusterrolebindings|rolebindings|clusterroles|roles\" | line_format `{{.verb}} {{.objectRef_resource}}/{{.objectRef_name}} in {{.objectRef_namespace}} by {{.user_username}}`",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Exec, port-forward and RBAC changes by humans",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
